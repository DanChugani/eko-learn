---
import Wordmark from '../ui/Wordmark.astro';
import { site } from '../../config/site.ts';
import { navLinks, primaryCta, subjects } from '../../content/home.ts';
import { isPlaceholder } from '../../lib/placeholders.ts';

const year = new Date().getFullYear();
const linkClass = 'inline-flex min-h-11 items-center text-paper underline-offset-4 hover:underline';
---

<footer class="bg-green text-paper">
  <div class="page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
    <div>
      <Wordmark tone="light" />
      <p class="mt-3 max-w-xs text-footer-muted">
        1-on-1 online tutoring for Grades 1 to 12, aligned to the Ontario curriculum. Assessment first.
      </p>
    </div>

    <nav aria-labelledby="footer-explore">
      <h2 id="footer-explore" class="font-sans text-sm font-bold tracking-[0.12em] text-accent-light uppercase">
        Explore
      </h2>
      <ul class="mt-3">
        {navLinks.map((link) => <li><a href={link.href} class={linkClass}>{link.label}</a></li>)}
        <li><a href={primaryCta.href} class={linkClass}>{primaryCta.label}</a></li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-subjects">
      <h2 id="footer-subjects" class="font-sans text-sm font-bold tracking-[0.12em] text-accent-light uppercase">
        Subjects
      </h2>
      <ul class="mt-3">
        {subjects.map((subject) => <li><a href={`#${subject.id}`} class={linkClass}>{subject.name}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="font-sans text-sm font-bold tracking-[0.12em] text-accent-light uppercase">Contact</h2>
      <ul class="mt-3">
        <li><a href={`mailto:${site.email}`} class={linkClass}>{site.email}</a></li>
        <li>
          {
            isPlaceholder(site.phone.e164) ? (
              <span class="inline-flex min-h-11 items-center">{site.phone.display}</span>
            ) : (
              <a href={`tel:${site.phone.e164}`} class={linkClass}>
                {site.phone.display}
              </a>
            )
          }
        </li>
        <li class="inline-flex min-h-11 items-center text-footer-muted">
          {site.location.city}, {site.location.region}
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-paper/20">
    <p class="page py-6 text-sm text-footer-muted">&copy; {year} {site.name}. All rights reserved.</p>
  </div>
</footer>
