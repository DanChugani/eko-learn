---
import SectionHeader from '../ui/SectionHeader.astro';
import { faqs } from '../../content/home.ts';
---

<section id="faq" class="section border-t border-line bg-paper-deep" aria-labelledby="faq-title">
  <div class="page grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16">
    <SectionHeader id="faq-title" eyebrow="FAQ" title="Questions parents ask first." />

    <div class="border-t-2 border-green">
      {
        faqs.map((faq) => (
          <details class="faq group border-b border-line">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4">
              <h3 class="font-display text-xl font-semibold text-ink">{faq.question}</h3>
              <svg
                class="shrink-0 text-green transition-transform group-open:rotate-45"
                width="20"
                height="20"
                viewBox="0 0 20 20"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M10 3v14M3 10h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </summary>
            <p class="max-w-2xl pb-6 text-muted">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>
