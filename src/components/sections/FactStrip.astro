---
import { facts } from '../../content/home.ts';
---

<section aria-label="At a glance" class="border-y border-line bg-card">
  <ul class="page grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
    {
      facts.map((fact, i) => (
        <li
          class:list={[
            'flex min-h-16 items-center justify-center px-3 py-4 text-center font-semibold text-brand',
            'border-line lg:border-l lg:first:border-l-0',
            i === facts.length - 1 && 'col-span-2 sm:col-span-1',
          ]}
        >
          {fact}
        </li>
      ))
    }
  </ul>
</section>
