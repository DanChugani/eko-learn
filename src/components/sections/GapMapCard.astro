---
import StatusIcon from '../ui/StatusIcon.astro';
import {
  sampleReport,
  statusDescriptions,
  statusLabels,
  type StrandStatus,
} from '../../content/sample-report.ts';

const pill: Record<StrandStatus, string> = {
  secure: 'bg-brand-tint text-brand',
  developing: 'bg-violet-tint text-violet-ink',
  gap: 'bg-accent-tint text-accent-ink',
};
const fill: Record<StrandStatus, string> = {
  secure: 'bg-brand',
  developing: 'bg-violet',
  gap: 'bg-accent',
};

const { grade, subject, source, expectation, strands, focus, recheck } = sampleReport;
---

<figure
  id="sample-report"
  class="card relative w-full p-5 shadow-[0_1px_0_#dcd6ee,0_16px_36px_-20px_rgba(43,45,133,0.35)] sm:p-7"
  aria-labelledby="sample-report-title"
>
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line pb-4">
    <p class="rounded-sm bg-accent-tint px-2 py-1 text-xs font-bold tracking-[0.12em] text-accent-ink uppercase">
      Sample report
    </p>
    <p class="text-sm text-muted">{source}</p>
  </div>

  <h2 id="sample-report-title" class="mt-4 font-display text-2xl text-brand">
    Gap map: Grade {grade} {subject}
  </h2>

  <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted" aria-label="Legend">
    {
      (Object.keys(statusLabels) as StrandStatus[]).map((status) => (
        <li class="inline-flex items-center gap-1.5">
          <span class:list={[pill[status], 'inline-flex rounded-full p-0.5']}>
            <StatusIcon status={status} />
          </span>
          {statusLabels[status]}
        </li>
      ))
    }
    <li class="inline-flex items-center gap-1.5">
      <span class="inline-block h-3.5 w-0.5 bg-ink" aria-hidden="true"></span>
      Grade {grade} expectation
    </li>
  </ul>

  <ul class="mt-5 space-y-4">
    {
      strands.map((strand, i) => (
        <li>
          <div class="flex items-baseline justify-between gap-3">
            <p class="font-semibold">
              <span class="mr-1.5 inline-block w-5 font-display text-brand">{strand.code}</span>
              {strand.name}
            </p>
            <p
              class:list={[
                pill[strand.status],
                'inline-flex shrink-0 items-center gap-1.5 rounded-full px-2.5 py-0.5 text-sm font-semibold',
              ]}
            >
              <StatusIcon status={strand.status} />
              {statusLabels[strand.status]}
            </p>
          </div>
          <p class="sr-only">
            {strand.name}, strand {strand.code}: {statusDescriptions[strand.status]}.
          </p>
          <div class="relative mt-2 h-2.5 rounded-full bg-track" aria-hidden="true">
            <div
              class:list={[fill[strand.status], 'gap-bar h-full rounded-full']}
              style={`width:${strand.level}%;--delay:${i * 90}ms`}
            />
            <div class="absolute -top-1 -bottom-1 w-0.5 bg-ink" style={`left:${expectation}%`} />
          </div>
        </li>
      ))
    }
  </ul>

  <div class="mt-6 rounded-md border border-brand/25 bg-brand-tint/60 p-4">
    <h3 class="font-display text-lg text-brand">Tutor focus, next 4 weeks</h3>
    <ol class="mt-2 space-y-2 text-[0.9375rem]">
      {
        focus.map((item) => (
          <li class="grid grid-cols-[7.5rem_1fr] gap-2 max-[380px]:grid-cols-1 max-[380px]:gap-0">
            <span class="font-semibold text-brand">{item.when}</span>
            <span>
              <span class="font-semibold">({item.code})</span> {item.text}
            </span>
          </li>
        ))
      }
    </ol>
    <p class="mt-3 border-t border-brand/20 pt-3 text-sm text-muted">{recheck}</p>
  </div>

  <figcaption class="mt-4 text-sm text-muted">
    Illustrative sample for a Grade {grade} student. Not a real student’s results.
  </figcaption>
</figure>

<style>
  .gap-bar {
    transform-origin: left center;
    animation: grow 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--delay);
  }
  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }
</style>
