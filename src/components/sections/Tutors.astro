---
import SectionHeader from '../ui/SectionHeader.astro';
import { site } from '../../config/site.ts';
---

<section id="tutors" class="section page" aria-labelledby="tutors-title">
  <SectionHeader
    id="tutors-title"
    eyebrow="Tutors"
    title="The people doing the teaching."
    lede="Your child works with the same tutor each session, and that tutor plans every lesson from your child’s gap map."
  />

  <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      site.tutors.map((tutor) => (
        <li class="card flex items-start gap-5 p-6">
          {tutor.photo ? (
            <img
              src={tutor.photo}
              alt=""
              width="96"
              height="96"
              loading="lazy"
              decoding="async"
              class="h-24 w-24 shrink-0 rounded-full object-cover"
            />
          ) : (
            <div
              class="flex h-24 w-24 shrink-0 items-center justify-center rounded-full border border-line bg-paper-deep"
              aria-hidden="true"
            >
              <svg width="44" height="44" viewBox="0 0 44 44" class="text-line">
                <circle cx="22" cy="16" r="8" fill="currentColor" />
                <path d="M6 40c2-9 9-13 16-13s14 4 16 13z" fill="currentColor" />
              </svg>
            </div>
          )}
          <div>
            <h3 class="text-xl text-green">{tutor.name}</h3>
            <p class="mt-1 font-semibold">{tutor.subjects}</p>
            <p class="mt-1 text-muted">{tutor.credential}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
