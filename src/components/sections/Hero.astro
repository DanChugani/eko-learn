---
import GapMapCard from './GapMapCard.astro';
import { hero, primaryCta } from '../../content/home.ts';
---

<section class="page grid items-center gap-12 pt-10 pb-16 lg:grid-cols-[1.15fr_1fr] lg:gap-16 lg:pt-16 lg:pb-24">
  <div>
    <p class="eyebrow">Ontario curriculum tutoring, Grades 1 to 12</p>
    <h1 class="mt-4 text-[clamp(2.5rem,1.4rem+4.2vw,4.25rem)] text-green">
      <span class="block"
        >Find the <span class="underline decoration-accent decoration-[0.08em] underline-offset-[0.2em] [text-decoration-skip-ink:none]">gaps</span
        >.</span
      >{' '}
      <span class="block">Teach the gaps.</span>
    </h1>
    <p class="lede mt-6">{hero.subline}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={primaryCta.href} class="btn btn-primary">{primaryCta.label}</a>
      <a href={hero.secondaryCta.href} class="btn btn-secondary">{hero.secondaryCta.label}</a>
    </div>
  </div>

  <GapMapCard />
</section>
