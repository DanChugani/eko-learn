---
/**
 * Brand mark: the logo's gold tree (canopy, trunk and roots) on an indigo-to-violet disc,
 * simplified to read at 16 to 32px. The same drawing is used for the favicon set.
 */
import { markSvgBody } from '../../lib/mark.ts';

interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
const gradientId = `mark-gradient-${size}`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={markSvgBody(gradientId)}
/>
