---
/** Brand mark: three strand bars, the shortest in the accent colour (a gap). Also used for the favicon. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="7" fill="#1f4d3f"></rect>
  <rect x="7" y="8" width="18" height="3.5" rx="1.75" fill="#f5f1e8"></rect>
  <rect x="7" y="14.25" width="13" height="3.5" rx="1.75" fill="#f5f1e8"></rect>
  <rect x="7" y="20.5" width="7" height="3.5" rx="1.75" fill="#f0a477"></rect>
</svg>
