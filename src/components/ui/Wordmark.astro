---
import Mark from './Mark.astro';

interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<a
  href="/"
  class:list={[
    'inline-flex min-h-11 items-center gap-2.5 font-display text-2xl font-semibold tracking-tight no-underline',
    tone === 'dark' ? 'text-green' : 'text-paper',
  ]}
>
  <Mark size={30} />
  <span>Ekolearn</span>
</a>
