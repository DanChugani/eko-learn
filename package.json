{
  "name": "eko-learn",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "check:copy": "node scripts/check-copy.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "verify": "npm run check && npm test && npm run build && npm run check:copy && npm run test:e2e",
    "check:launch": "npm run verify && npm run check:placeholders -- --strict"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
